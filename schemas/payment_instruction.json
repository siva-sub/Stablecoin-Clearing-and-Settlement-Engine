{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PaymentInstruction",
    "description": "A payment instruction modelled after ISO 20022 pacs.008 with IVMS101 extensions",
    "type": "object",
    "required": [
        "instructionId",
        "debtorAgent",
        "creditorAgent",
        "amount",
        "currency",
        "valueDate"
    ],
    "properties": {
        "instructionId": {
            "type": "string",
            "description": "Unique instruction ID (idempotency key). Maps to PmtId/InstrId"
        },
        "endToEndId": {
            "type": "string",
            "description": "End-to-end ID generated by the originator. Maps to PmtId/EndToEndId"
        },
        "debtorAgent": {
            "type": "object",
            "description": "Sending VASP/Bank (Financial Institution). Maps to DbtrAgt",
            "required": [
                "agentId"
            ],
            "properties": {
                "agentId": {
                    "type": "string",
                    "description": "BIC or VASP ID"
                },
                "account": {
                    "type": "string",
                    "description": "Optional settlement account"
                }
            }
        },
        "creditorAgent": {
            "type": "object",
            "description": "Receiving VASP/Bank (Financial Institution). Maps to CdtrAgt",
            "required": [
                "agentId"
            ],
            "properties": {
                "agentId": {
                    "type": "string",
                    "description": "BIC or VASP ID"
                },
                "account": {
                    "type": "string",
                    "description": "Optional settlement account"
                }
            }
        },
        "amount": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]{1,18})?$",
            "description": "Decimal string representation of the amount"
        },
        "currency": {
            "type": "string",
            "enum": [
                "USDC",
                "USDT",
                "EURC"
            ],
            "description": "Asset code"
        },
        "valueDate": {
            "type": "string",
            "format": "date",
            "description": "Requested execution date"
        },
        "priority": {
            "type": "string",
            "enum": [
                "HIGH",
                "NORMAL"
            ],
            "default": "NORMAL"
        },
        "remittanceInfo": {
            "type": "string",
            "maxLength": 140,
            "description": "Unstructured remittance information"
        },
        "ivms101": {
            "type": "object",
            "description": "Travel Rule payload compliant with IVMS101 standard. Required if amount >= threshold.",
            "properties": {
                "Originator": {
                    "type": "object",
                    "properties": {
                        "originatorPersons": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "naturalPerson": {
                                        "type": "object",
                                        "properties": {
                                            "name": {
                                                "type": "object",
                                                "properties": {
                                                    "nameIdentifier": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "object",
                                                            "required": [
                                                                "primaryIdentifier",
                                                                "nameIdentifierType"
                                                            ],
                                                            "properties": {
                                                                "primaryIdentifier": {
                                                                    "type": "string"
                                                                },
                                                                "secondaryIdentifier": {
                                                                    "type": "string"
                                                                },
                                                                "nameIdentifierType": {
                                                                    "type": "string",
                                                                    "enum": [
                                                                        "ALIA",
                                                                        "BIRT",
                                                                        "MAID",
                                                                        "LEGL",
                                                                        "MISC"
                                                                    ]
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    },
                                    "legalPerson": {
                                        "type": "object"
                                    }
                                }
                            }
                        },
                        "accountNumber": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "Beneficiary": {
                    "type": "object",
                    "properties": {
                        "beneficiaryPersons": {
                            "type": "array"
                        },
                        "accountNumber": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "signature": {
            "type": "string",
            "description": "EIP-712 signature of the core instruction fields by the debtor"
        }
    }
}