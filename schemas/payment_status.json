{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PaymentStatus",
    "description": "A payment status report modelled after ISO 20022 pacs.002",
    "type": "object",
    "required": [
        "instructionId",
        "status",
        "timestamp"
    ],
    "properties": {
        "instructionId": {
            "type": "string",
            "description": "Reference to the original instruction ID provided by the Debtor Agent"
        },
        "status": {
            "type": "string",
            "enum": [
                "RECEIVED",
                "VALIDATED",
                "REJECTED",
                "CLEARED",
                "QUEUED",
                "NETTED",
                "PENDING_SETTLEMENT",
                "SETTLED",
                "FAILED",
                "REVERSED"
            ],
            "description": "Current lifecycle status"
        },
        "reasonCode": {
            "type": "string",
            "description": "ISO-like reason code (e.g., AM09 for insufficient funds)"
        },
        "reasonDescription": {
            "type": "string",
            "description": "Human readable description of the status reason"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Time of status change"
        },
        "settlementReference": {
            "type": "string",
            "description": "On-chain transaction hash if settled"
        }
    }
}